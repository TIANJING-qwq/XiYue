<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.SettingsView">
    <Grid>
    <ScrollViewer x:Name="SettingsScrollViewer">
        <StackPanel Margin="24" Spacing="20" MaxWidth="700">

            <!-- 网络认证 -->
            <TextBlock Text="网络认证" FontSize="16" FontWeight="SemiBold"/>
            <StackPanel Spacing="10">
                <TextBlock Text="用户名" FontSize="13"/>
                <TextBox x:Name="UsernameBox" Watermark="请输入校园网账号"/>

                <TextBlock Text="密码" FontSize="13" Margin="0,8,0,0"/>
                <TextBox x:Name="PasswordBox" PasswordChar="*" Watermark="请输入密码"/>

                <Button Content="保存凭据"
                        HorizontalAlignment="Left"
                        Padding="20,8"
                        Margin="0,8,0,0"
                        Click="SaveCredentials_Click"/>
            </StackPanel>

            <!-- 主题 -->
            <TextBlock Text="主题" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <StackPanel Spacing="10">
                <TextBlock Text="外观模式" FontSize="13"/>
                <ComboBox x:Name="ThemeModeComboBox"
                          Width="220"
                          HorizontalAlignment="Left"
                          SelectionChanged="ThemeModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="浅色"/>
                    <ComboBoxItem Content="深色"/>
                    <ComboBoxItem Content="跟随系统"/>
                </ComboBox>
            </StackPanel>

            <!-- 窗口材质 -->
            <TextBlock Text="窗口材质" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <StackPanel Spacing="10">
                <TextBlock Text="窗口背景效果" FontSize="13"/>
                <ComboBox x:Name="WindowBackdropComboBox"
                          Width="280"
                          HorizontalAlignment="Left"
                          SelectionChanged="WindowBackdropComboBox_SelectionChanged">
                    <ComboBoxItem Content="云母（Win11 推荐）"/>
                    <ComboBoxItem Content="亚克力（实时模糊）"/>
                    <ComboBoxItem Content="无（不透明）"/>
                </ComboBox>
                <TextBlock Text="云母/亚克力仅在深色模式下生效，浅色模式自动回退到不透明"
                           FontSize="11" Opacity="0.5"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 点击音效 -->
            <TextBlock Text="点击音效" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="启用点击音效" FontSize="13"/>
                        <TextBlock Text="点击任意控件时播放音效"
                                   FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="ClickSoundSwitch"
                                  IsCheckedChanged="ClickSoundSwitch_Changed"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,60">
                    <TextBlock Grid.Column="0"
                               Text="音量"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            x:Name="ClickSoundVolumeSlider"
                            Width="200"
                            Minimum="0" Maximum="100"
                            Value="80"
                            VerticalAlignment="Center"
                            ValueChanged="ClickSoundVolumeSlider_ValueChanged"/>
                    <TextBlock Grid.Column="2"
                               x:Name="ClickSoundVolumeText"
                               Text="80"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="音效文件"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <ComboBox x:Name="ClickSoundFileComboBox"
                                  Width="220"
                                  SelectionChanged="ClickSoundFileComboBox_SelectionChanged"/>
                        <Button Content="刷新"
                                Padding="12,6"
                                Click="RefreshSounds_Click"/>
                        <Button Content="试听"
                                Padding="12,6"
                                Click="PreviewSound_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="SoundsHintText"
                           FontSize="11" Opacity="0.5"
                           TextWrapping="Wrap"
                           Text="把 .wav 文件放到程序目录的 Sounds\ 文件夹，点「刷新」即可看到"/>
            </StackPanel>

                        <!-- ★ 图库位置 -->
            <TextBlock Text="图库位置" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="GalleryPathBox"
                             IsReadOnly="True"
                             Watermark="默认路径"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="8,0,0,0">
                        <Button Content="浏览..."
                                Padding="14,6"
                                Click="BrowseGalleryPath_Click"/>
                        <Button Content="打开"
                                Padding="14,6"
                                Click="OpenGalleryPath_Click"/>
                        <Button Content="重置"
                                Padding="14,6"
                                Click="ResetGalleryPath_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="图库资源（bili.zip）会下载并保存到该目录。修改后需要重新下载。"
                           FontSize="11" Opacity="0.5"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <!-- 更新代理 -->
            <TextBlock Text="更新代理" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <StackPanel Spacing="10">
                <TextBlock Text="下载更新时使用的代理" FontSize="13"/>
                <ComboBox x:Name="UpdateProxyComboBox"
                          Width="280"
                          HorizontalAlignment="Left"
                          SelectionChanged="UpdateProxyComboBox_SelectionChanged">
                    <ComboBoxItem Content="直连（不使用代理）"/>
                    <ComboBoxItem Content="gh-proxy.com"/>
                    <ComboBoxItem Content="gh-proxy.org"/>
                    <ComboBoxItem Content="v4.gh-proxy.org"/>
                    <ComboBoxItem Content="v6.gh-proxy.org"/>
                </ComboBox>
            </StackPanel>

            <!-- 通知 -->
            <TextBlock Text="通知" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="新通知到达时自动折叠堆叠" FontSize="13"/>
                    <TextBlock Text="多条通知时只显示最新一条，其余收起"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="AutoCollapseSwitch"
                              IsCheckedChanged="AutoCollapseSwitch_Changed"/>
            </Grid>

            <!-- 插件联动 -->
            <TextBlock Text="插件联动" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="收到插件通知时执行自动动作" FontSize="13"/>
                    <TextBlock Text="打开多个浏览器窗口 + 音量保持"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="AutoActionSwitch"
                              IsCheckedChanged="AutoActionSwitch_Changed"/>
            </Grid>

            <StackPanel Spacing="10">
                <TextBlock Text="自动打开的 URL" FontSize="13"/>
                <TextBox x:Name="AutoActionUrlBox"
                         Watermark="https://..."
                         LostFocus="AutoActionUrlBox_LostFocus"/>

                <Grid ColumnDefinitions="*,140">
                    <TextBlock Grid.Column="0"
                               Text="打开窗口数量"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   x:Name="AutoActionCountBox"
                                   Minimum="1" Maximum="50"
                                   Increment="1"
                                   FormatString="0"
                                   ValueChanged="AutoActionCountBox_ValueChanged"/>
                </Grid>

                <Grid ColumnDefinitions="*,140">
                    <TextBlock Grid.Column="0"
                               Text="打开间隔（毫秒）"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   x:Name="AutoActionIntervalBox"
                                   Minimum="100" Maximum="3000"
                                   Increment="50"
                                   FormatString="0"
                                   ValueChanged="AutoActionIntervalBox_ValueChanged"/>
                </Grid>

                <Grid ColumnDefinitions="*,140">
                    <TextBlock Grid.Column="0"
                               Text="目标音量（0-100）"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   x:Name="AutoActionVolumeBox"
                                   Minimum="0" Maximum="100"
                                   Increment="5"
                                   FormatString="0"
                                   ValueChanged="AutoActionVolumeBox_ValueChanged"/>
                </Grid>

                <Grid ColumnDefinitions="*,140">
                    <TextBlock Grid.Column="0"
                               Text="音量保持时间（秒）"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   x:Name="AutoActionHoldBox"
                                   Minimum="0" Maximum="600"
                                   Increment="5"
                                   FormatString="0"
                                   ValueChanged="AutoActionHoldBox_ValueChanged"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="显示置顶遮罩" FontSize="13"/>
                        <TextBlock Text="执行时右上角遮罩挡住关闭按钮"
                                   FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="OverlaySwitch"
                                  IsCheckedChanged="OverlaySwitch_Changed"/>
                </Grid>

                <Grid ColumnDefinitions="*,140">
                    <TextBlock Grid.Column="0"
                               Text="遮罩显示时间（秒）"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   x:Name="OverlaySecondsBox"
                                   Minimum="1" Maximum="300"
                                   Increment="1"
                                   FormatString="0"
                                   ValueChanged="OverlaySecondsBox_ValueChanged"/>
                </Grid>
                                <!-- ★ 密码确认框 -->
                <TextBlock Text="密码确认框"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,16,0,0"/>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="启用密码确认" FontSize="13"/>
                        <TextBlock Text="收到插件通知时弹出密码框，输入正确密码可取消"
                                   FontSize="11" Opacity="0.5"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  x:Name="PasswordPromptSwitch"
                                  IsCheckedChanged="PasswordPromptSwitch_Changed"/>
                </Grid>

                <Grid ColumnDefinitions="*,140">
                    <TextBlock Grid.Column="0"
                               Text="倒计时（秒）"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1"
                                   x:Name="PasswordPromptSecondsBox"
                                   Minimum="3" Maximum="120"
                                   Increment="1"
                                   FormatString="0"
                                   ValueChanged="PasswordPromptSecondsBox_ValueChanged"/>
                </Grid>

                <Grid ColumnDefinitions="*,200">
                    <TextBlock Grid.Column="0"
                               Text="取消密码"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             x:Name="PasswordPromptPasswordBox"
                             Watermark="1145"
                             FontSize="13"
                             LostFocus="PasswordPromptPasswordBox_LostFocus"/>
                </Grid>
            </StackPanel>

            <!-- 程序选项 -->
            <TextBlock Text="程序选项" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="开机自启动" FontSize="13"/>
                    <TextBlock Text="登录系统后自动启动汐月"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="AutoStartSwitch"
                              IsCheckedChanged="AutoStartSwitch_Changed"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="自启动时隐藏到托盘" FontSize="13"/>
                    <TextBlock Text="开机后不显示主窗口，仅在托盘中运行"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="AutoStartMinimizedSwitch"
                              IsCheckedChanged="AutoStartMinimizedSwitch_Changed"/>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="关闭时直接最小化到托盘" FontSize="13"/>
                    <TextBlock Text="不再弹出询问对话框"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="MinTraySwitch"
                              IsCheckedChanged="MinTraySwitch_Changed"/>
            </Grid>
                        <!-- ★ 退出安全码 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="退出时验证安全码" FontSize="13"/>
                    <TextBlock Text="开启后，点击「退出」按钮需输入安全码"
                               FontSize="11" Opacity="0.5"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="QuitPasswordSwitch"
                              IsCheckedChanged="QuitPasswordSwitch_Changed"/>
            </Grid>

            <StackPanel x:Name="QuitPasswordSetPanel" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="QuitPasswordBox"
                             PasswordChar="●"
                             Watermark="设置退出安全码"
                             FontSize="13"/>
                    <Button Grid.Column="1"
                            Content="保存"
                            Padding="16,6"
                            Margin="8,0,0,0"
                            Click="SaveQuitPassword_Click"/>
                </Grid>
                <TextBlock Text="留空表示不使用安全码"
                           FontSize="11" Opacity="0.5"/>
            </StackPanel>

            <!-- ★ 更改设置需要安全码（依赖上面的安全码） -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="更改设置需要安全码" FontSize="13"/>
                    <TextBlock Text="开启后，每次进入本页需先输入安全码才能修改任何选项（仅在已开启并设置上面的安全码时生效）"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="ProtectSettingsSwitch"
                              IsCheckedChanged="ProtectSettingsSwitch_Changed"/>
            </Grid>

            <Border Height="24"/>
        </StackPanel>
    </ScrollViewer>

        <!-- ★ 设置锁：开启「更改设置需要安全码」时覆盖本页 -->
        <Border x:Name="SettingsLockOverlay"
                IsVisible="False"
                Background="#D9101010">
            <Border Background="#F01C1C1C"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="设置已锁定"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="更改设置需要安全码，请输入后解锁本次设置。"
                               FontSize="13"
                               Foreground="#CCFFFFFF"
                               TextWrapping="Wrap"/>

                    <TextBox x:Name="UnlockCodeBox"
                             PasswordChar="●"
                             Watermark="输入安全码"
                             FontSize="14"
                             Padding="10,8"
                             KeyDown="UnlockCodeBox_KeyDown"/>

                    <TextBlock x:Name="UnlockErrorText"
                               Text=""
                               FontSize="12"
                               Foreground="#FFE81123"
                               IsVisible="False"/>

                    <Button x:Name="UnlockButton"
                            Content="解锁"
                            Click="UnlockButton_Click"
                            HorizontalAlignment="Right"
                            Padding="20,8"
                            MinWidth="88"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#FF0078D4"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>