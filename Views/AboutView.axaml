<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.AboutView">
    <ScrollViewer>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Margin="0,40,0,40"
                    MaxWidth="480">

            <Image x:Name="AppIcon"
                   Width="96" Height="96"
                   Source="avares://SBtools/Assets/app.png"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

            <TextBlock x:Name="TitleText"
                       Text="XY"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="ChineseName"
                       Text="汐月"
                       FontSize="16"
                       Opacity="0.85"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <Border x:Name="Divider"
                    Height="1"
                    Width="200"
                    Background="#30808080"
                    Margin="0,12,0,12"/>

            <TextBlock x:Name="LineAuthor"
                       Text="SchoolBusytools 项目组 · tianjing &amp; deepseek"
                       FontSize="13"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineTeam"
                       Text="校园网自动认证 · 轻量校园工具集"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineBuild"
                       Text="基于 C# / .NET 8 + Avalonia UI 构建"
                       FontSize="12"
                       Opacity="0.7"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineVersion"
                       Text="版本 Dev0.3"
                       FontSize="12"
                       Opacity="0.5"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineDesc"
                       Text="纯客户端工具，不收集任何用户数据"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">

                <Button x:Name="GitHubButton"
                        Content="GitHub 仓库"
                        Padding="20,8"
                        Click="GitHubButton_Click"/>

                <Button x:Name="CheckUpdateButton"
                        Content="检查更新"
                        Padding="20,8"
                        Classes="accent"
                        Click="CheckUpdateButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="UpdateStatusText"
                       FontSize="11"
                       Opacity="0.5"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>