<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SBtools.ViewModels"
             x:Class="SBtools.Views.SettingsTabView"
             x:DataType="vm:SettingsTabViewModel">    <Design.DataContext>
        <vm:SettingsTabViewModel />
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="15">
        <Expander Header="WiFi认证设置" IsExpanded="True">
            <StackPanel Spacing="10">
                <TextBlock Text="账号:" />
                <TextBox Text="{Binding Username}" Watermark="输入账号" />
                <TextBlock Text="密码:" />
                <TextBox Text="{Binding Password}" PasswordChar="*" />
                <Button Content="保存" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>