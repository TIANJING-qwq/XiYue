<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SBtools.Views.PasswordPromptWindow"
        Title=""
        WindowStartupLocation="Manual"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="440"
        Height="200">

    <Border Background="#E6000000"
            CornerRadius="10"
            Padding="20,16">
        <StackPanel Spacing="10">

            <TextBlock Text="确认操作"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White"/>

            <TextBlock Text="检测到插件通知，10 秒内输入密码可取消自动动作"
                       FontSize="12"
                       Foreground="#CCFFFFFF"
                       TextWrapping="Wrap"/>

            <TextBox x:Name="PasswordBox"
                     PasswordChar="●"
                     Watermark="输入密码"
                     FontSize="14"
                     Padding="10,8"
                     Margin="0,4,0,0"
                     KeyDown="PasswordBox_KeyDown"/>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="CountdownText"
                           Grid.Column="0"
                           Text="10 秒"
                           FontSize="12"
                           Foreground="#AAFFFFFF"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="ConfirmButton"
                        Content="取消自动动作"
                        FontSize="12"
                        Padding="14,6"
                        Click="ConfirmButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>