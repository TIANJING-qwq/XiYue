<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SBtools.Views.CloseConfirmDialog"
        Width="460"
        SizeToContent="Height"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Name="RootCard"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="10"
            Background="#F3F3F3"
            Padding="24"
            Opacity="0"
            RenderTransformOrigin="50%,50%"
            BoxShadow="0 16 48 0 #60000000">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                    <DoubleTransition.Easing>
                        <CubicEaseOut />
                    </DoubleTransition.Easing>
                </DoubleTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28">
                    <TransformOperationsTransition.Easing>
                        <BackEaseOut />
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Border.Transitions>

        <StackPanel Spacing="14">

            <!-- 标题 -->
            <TextBlock Text="关闭 汐月"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <!-- 说明 -->
            <TextBlock Text="你想退出程序，还是最小化到系统托盘继续运行？"
                       FontSize="14"
                       Foreground="#606060"
                       TextWrapping="Wrap" />

            <!-- ★ 不再询问 -->
            <CheckBox Name="DontAskAgainCheckbox"
                      Content="下次不再询问，直接最小化到托盘"
                      FontSize="13" />

            <!-- 按钮组 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,10,0,0">

                <Button Name="CancelButton"
                        Content="取消"
                        Padding="18,8"
                        CornerRadius="6"
                        Background="Transparent"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Click="CancelButton_Click" />

                <Button Name="MinimizeButton"
                        Content="最小化到托盘"
                        Padding="18,8"
                        CornerRadius="6"
                        Background="Transparent"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        Click="MinimizeButton_Click" />

                <Button Name="QuitButton"
                        Content="退出"
                        Padding="18,8"
                        CornerRadius="6"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        Click="QuitButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>