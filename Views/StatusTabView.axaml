<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SBtools.ViewModels"
             x:Class="SBtools.Views.StatusTabView"
             x:CompileBindings="False">
    <Design.DataContext>
        <vm:StatusTabViewModel />
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="15">
        <!-- 互联网状态 -->
        <Expander Header="互联网状态" IsExpanded="True">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="16" Foreground="{Binding StatusColor}" />
                <TextBlock Text="{Binding IpInfo}" />
                <TextBlock Text="{Binding LoadingText}" Foreground="Gray" FontStyle="Italic" />
            </StackPanel>
        </Expander>

        <!-- 连接统计 -->
        <Expander Header="连接统计" IsExpanded="True">
            <StackPanel>
                <TextBlock Text="连接尝试: {Binding AttemptCount}" />
                <TextBlock Text="最后连接: 无" />
            </StackPanel>
        </Expander>

        <!-- 控制面板 -->
        <Expander Header="控制面板" IsExpanded="True">
            <StackPanel Spacing="8">
                <!-- 用水平布局替代 Header -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="启用自动连接" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding AutoConnectEnabled}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="自动验证网络" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding AutoVerifyEnabled}" />
                </StackPanel>
                <Button Content="立即连接" Command="{Binding ConnectCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="开机自启动" VerticalAlignment="Center" />
                    <ToggleSwitch IsChecked="{Binding AutoStartEnabled}" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- 操作按钮 -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="隐藏到托盘" Command="{Binding MinimizeCommand}" />
            <Button Content="退出" Command="{Binding ExitCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>