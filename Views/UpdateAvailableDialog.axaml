<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ea="using:Avalonia.Animation.Easings"
        x:Class="SBtools.Views.UpdateAvailableDialog"
        Title="发现新版本"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        TransparencyBackgroundFallback="#F3F3F3">

    <Border x:Name="RootCard"
            Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="28"
            Margin="1">

        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                    <DoubleTransition.Easing>
                        <ea:CubicEaseOut/>
                    </DoubleTransition.Easing>
                </DoubleTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28">
                    <TransformOperationsTransition.Easing>
                        <ea:QuinticEaseOut/>
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Border.Transitions>

        <StackPanel Spacing="16">

            <TextBlock Text="发现新版本"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <TextBlock x:Name="VersionText"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="14"
                    MaxHeight="220">
                <ScrollViewer>
                    <TextBlock x:Name="ChangelogText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,4,0,0">

                <Button x:Name="LaterButton"
                        Content="稍后再说"
                        Padding="20,8"
                        MinWidth="96"
                        CornerRadius="6"
                        Click="LaterButton_Click"/>

                <Button x:Name="DownloadButton"
                        Classes="accent"
                        Content="立即更新"
                        Padding="20,8"
                        MinWidth="96"
                        CornerRadius="6"
                        FontWeight="SemiBold"
                        Click="DownloadButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>