<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.NetworkView">

    <TabControl Margin="12">

        <!-- Tab 1：网络连接 -->
        <TabItem Header="网络连接">
            <ScrollViewer>
                <StackPanel Margin="24" Spacing="16" MaxWidth="720">

                    <!-- 状态卡片 -->
                    <Border Background="#18000000"
                            CornerRadius="10"
                            Padding="20">
                        <StackPanel Spacing="12">

                            <TextBlock Text="当前状态"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Opacity="0.7"/>

                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{Binding StatusColor}"/>

                            <TextBlock Text="{Binding IpInfo}"
                                       FontSize="13"
                                       Opacity="0.8"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding LoadingText}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Foreground="#FF0078D4"
                                       IsVisible="{Binding LoadingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <TextBlock Text="{Binding AttemptCount, StringFormat='累计认证次数: {0}'}"
                                       FontSize="12"
                                       Opacity="0.5"/>
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="立即连接"
                                Padding="24,10"
                                Click="ConnectButton_Click"/>
                        <Button Content="刷新检测"
                                Padding="24,10"
                                Click="RefreshButton_Click"/>
                    </StackPanel>

                    <!-- 选项 -->
                    <Border Background="#10000000"
                            CornerRadius="10"
                            Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="选项" FontSize="13" FontWeight="SemiBold" Opacity="0.6"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="自动连接" FontSize="13" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoConnectEnabled}"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="自动验证" FontSize="13" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoVerifyEnabled}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 连接记录 -->
                    <TextBlock Text="连接记录"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               Margin="0,8,0,0"/>

                    <Border Background="#10000000"
                            CornerRadius="10"
                            Padding="16"
                            MinHeight="120"
                            MaxHeight="240">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ConnectionHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   Opacity="0.75"
                                                   Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Tab 2：定时播放 -->
        <TabItem Header="定时播放">
            <ScrollViewer>
                <StackPanel Margin="24" Spacing="16" MaxWidth="600">

                    <TextBlock Text="定时播放 CCTV"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="启用定时播放"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="ScheduleEnabledSwitch"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,140">
                        <TextBlock Grid.Column="0"
                                   Text="开始时间"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TimePicker Grid.Column="1"
                                    x:Name="StartTimePicker"
                                    ClockIdentifier="24HourClock"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,140">
                        <TextBlock Grid.Column="0"
                                   Text="结束时间"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TimePicker Grid.Column="1"
                                    x:Name="EndTimePicker"
                                    ClockIdentifier="24HourClock"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,180">
                        <TextBlock Grid.Column="0"
                                   Text="频道"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  x:Name="ScheduleChannelComboBox"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="直播源（每日自动更新）"
                                       FontSize="13"/>
                            <TextBlock x:Name="ChannelSourceStatusText"
                                       FontSize="11"
                                       Opacity="0.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="立即更新源"
                                Padding="14,6"
                                Margin="8,0,0,0"
                                Click="RefreshChannelSource_Click"/>
                    </Grid>

                    <TextBlock x:Name="ScheduleStatusText"
                               FontSize="12"
                               Opacity="0.6"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存设置"
                                Padding="24,10"
                                Click="SaveScheduleButton_Click"/>
                        <Button Content="测试播放"
                                Padding="24,10"
                                Click="TestPlaybackButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>