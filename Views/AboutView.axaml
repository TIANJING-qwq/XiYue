<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.AboutView">
    <UserControl.Styles>
        <!-- 主要按钮：蓝色实底 -->
        <Style Selector="Button.primaryBtn">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primaryBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primaryBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.primaryBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF6B7280"/>
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
        </Style>

        <!-- 次要按钮：灰色实底 -->
        <Style Selector="Button.secondaryBtn">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.secondaryBtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF4B5563"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.secondaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF374151"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.secondaryBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF1F2937"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Margin="0,40,0,40"
                    MaxWidth="520">

            <Image x:Name="AppIcon"
                   Width="96" Height="96"
                   Source="avares://SBtools/Assets/app.png"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

            <TextBlock x:Name="TitleText"
                       Text="XY"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="ChineseName"
                       Text="汐月"
                       FontSize="16"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <Border x:Name="Divider"
                    Height="1"
                    Width="200"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Margin="0,12,0,12"/>

            <TextBlock x:Name="LineAuthor"
                       Text="SchoolBusytools 项目组 · tianjing &amp; deepseek"
                       FontSize="13"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineTeam"
                       Text="校园网自动认证 · 轻量校园工具集"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineBuild"
                       Text="基于 C# / .NET 8 + Avalonia UI 构建"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineVersion"
                       Text="版本 Dev0.3.1"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="LineDesc"
                       Text="纯客户端工具，不收集任何用户数据"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="14"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0">

                <Button x:Name="GitHubButton"
                        Classes="secondaryBtn"
                        Click="GitHubButton_Click">
                    <TextBlock Text="GitHub 仓库" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="CheckUpdateButton"
                        Classes="primaryBtn"
                        Click="CheckUpdateButton_Click">
                    <TextBlock Text="检查更新" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <TextBlock x:Name="UpdateStatusText"
                       FontSize="11"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>