<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Controls.NotificationToast"
             Width="320"
             MinHeight="88"
             ClipToBounds="True">

    <Border Name="RootBorder"
            Width="320"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#30FFFFFF"
            Opacity="0"
            ClipToBounds="True"
            BoxShadow="0 8 24 0 #80000000">

        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#E61E1E1E" Offset="0" />
                <GradientStop Color="#E62D2D2D" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid RowDefinitions="*,Auto">

            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="14,12,10,8">

                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="16"
                        Background="#1FFFFFFF"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0">
                    <PathIcon Width="15" Height="15"
                              Foreground="#60CDFF"
                              Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="3"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <TextBlock Name="TitleText"
                               Text="通知"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="MessageText"
                               Text="通知内容"
                               FontSize="11.5"
                               Foreground="#B3FFFFFF"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2"
                        Name="CloseButton"
                        Width="22" Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click">
                    <PathIcon Width="8" Height="8"
                              Foreground="#99FFFFFF"
                              Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Height="3" Background="#1AFFFFFF">
                <Border Name="ProgressFill"
                        HorizontalAlignment="Stretch"
                        Background="#60CDFF"
                        RenderTransformOrigin="0%,50%" />
            </Grid>

        </Grid>
    </Border>
</UserControl>