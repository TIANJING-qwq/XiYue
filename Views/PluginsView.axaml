<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:plg="using:SBtools.Plugins"
             x:Class="SBtools.Views.PluginsView">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="20,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="插件"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText"
                               Text=""
                               FontSize="13"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="打开插件目录"
                            Padding="16,6"
                            Click="OpenFolder_Click"/>
                    <Button Content="重新加载"
                            Padding="16,6"
                            Click="Reload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="PluginList" Margin="20,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="plg:PluginInfo">
                        <Border Margin="0,0,0,10"
                                Padding="16"
                                CornerRadius="8"
                                Background="#18000000">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                               FontSize="12"
                                               Opacity="0.5"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#FF107C10"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            IsVisible="{Binding IsLoaded}">
                                        <TextBlock Text="已加载"
                                                   FontSize="10"
                                                   Foreground="White"/>
                                    </Border>
                                    <Border Background="#FFC42B1C"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            IsVisible="{Binding !IsLoaded}">
                                        <TextBlock Text="失败"
                                                   FontSize="10"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Author, StringFormat=作者: {0}}"
                                           FontSize="11"
                                           Opacity="0.5"/>

                                <TextBlock Text="{Binding Id, StringFormat=ID: {0}}"
                                           FontSize="11"
                                           Opacity="0.5"/>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="11"
                                           Foreground="#FFC42B1C"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EmptyPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    IsVisible="False">
            <TextBlock Text="还没有安装插件"
                       FontSize="16"
                       Opacity="0.7"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyHint"
                       FontSize="12"
                       Opacity="0.5"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="500"/>
        </StackPanel>
    </Grid>
</UserControl>