<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.SettingsView">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">

            <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="配置认证信息与程序选项"
                       FontSize="14" Opacity="0.6" />

            <!-- WiFi 认证 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="WiFi 认证" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="账号" FontSize="13" />
                        <TextBox Name="UsernameBox" Watermark="输入账号" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="密码" FontSize="13" />
                        <TextBox Name="PasswordBox" PasswordChar="*" Watermark="输入密码" />
                    </StackPanel>
                    <Button Content="保存" Click="SaveCredentials_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 通知设置 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="通知" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="新通知到达时自动折叠堆叠"
                                   VerticalAlignment="Center"
                                   Width="240" />
                        <ToggleSwitch Name="AutoCollapseSwitch"
                                      OnContent=""
                                      OffContent=""
                                      IsCheckedChanged="AutoCollapseSwitch_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ★ 定时播放 CCTV -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="定时播放 CCTV" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="到设定时段时自动全屏打开所选频道。支持跨午夜时段。"
                               FontSize="13" Opacity="0.7" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="启用定时播放" VerticalAlignment="Center" Width="160" />
                        <ToggleSwitch Name="ScheduleEnabledSwitch" OnContent="" OffContent="" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="时段"
                                   VerticalAlignment="Center"
                                   Width="160" />
                        <TimePicker Grid.Column="1"
                                    Name="StartTimePicker"
                                    ClockIdentifier="24HourClock"
                                    HorizontalAlignment="Left"
                                    Width="140" />
                        <TextBlock Grid.Column="2"
                                   Text=" 至 "
                                   VerticalAlignment="Center" />
                        <TimePicker Grid.Column="3"
                                    Name="EndTimePicker"
                                    ClockIdentifier="24HourClock"
                                    HorizontalAlignment="Left"
                                    Width="140" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="默认频道" VerticalAlignment="Center" Width="160" />
                        <ComboBox Name="ChannelSelector" Width="240" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="TestPlaybackButton"
                                Content="测试播放"
                                Click="TestPlaybackButton_Click" />
                        <Button Name="SaveScheduleButton"
                                Content="保存设置"
                                Click="SaveScheduleButton_Click" />
                    </StackPanel>

                    <TextBlock Name="ScheduleStatusText"
                               FontSize="12"
                               Opacity="0.6"
                               Text="当前未启用" />
                </StackPanel>
            </Border>

            <!-- 程序选项 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="程序选项" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="开机自启动" VerticalAlignment="Center" Width="240" />
                        <ToggleSwitch OnContent="" OffContent="" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="最小化到托盘" VerticalAlignment="Center" Width="240" />
                        <ToggleSwitch OnContent="" OffContent="" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>