<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.AboutView">

    <ScrollViewer>
        <StackPanel Margin="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="10">

            <Image Name="AppIcon"
                   Source="/Assets/app.png"
                   Width="96" Height="96"
                   HorizontalAlignment="Center"
                   Opacity="0" />

            <TextBlock Name="TitleText"
                       Text="XY"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#0067c0"
                       HorizontalAlignment="Center"
                       Opacity="0" />

            <TextBlock Name="ChineseName"
                       Text="汐月"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0067c0"
                       HorizontalAlignment="Center"
                       Opacity="0" />

            <Border Name="Divider"
                    Height="1" Width="180"
                    Background="#e5e5e5"
                    Margin="0,10"
                    Opacity="0" />

            <TextBlock Name="LineAuthor"
                       Text="SchoolBusytools 项目组制作"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Opacity="0" />

            <TextBlock Name="LineBuild"
                       Text="基于 C# / .NET 8 + Avalonia UI 构建"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"
                       Opacity="0" />

            <TextBlock Name="LineVersion"
                       Text="版本 1.2.0"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Opacity="0" />

            <TextBlock Name="LineDesc"
                       Text="校园网自动认证 · 轻量校园工具集"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Opacity="0" />

                        <!-- ★ 制作人员 -->
            <Border Name="CreditsSection"
                    Margin="0,20,0,0"
                    Opacity="0">
                <StackPanel Spacing="14">

                    <TextBlock Text="制作人员"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="36">

                        <!-- TIANJING -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="72" Height="72"
                                    CornerRadius="36"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Image x:Name="TJImage" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="TIANJING"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="开发者"
                                       FontSize="11"
                                       Opacity="0.55"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- deepseek -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="72" Height="72"
                                    CornerRadius="36"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Image x:Name="DeepImage" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="deepseek"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="蓝色大肥鱼"
                                       FontSize="11"
                                       Opacity="0.55"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Opacity="0"
                        x:Name="ButtonRow">

                <Button Name="GitHubButton"
                        Content="github.com/TIANJING-qwq/XiYue"
                        FontSize="12"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="#0067c0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Foreground="#0067c0"
                        Cursor="Hand"
                        Click="GitHubButton_Click" />

                <Button Name="CheckUpdateButton"
                        Content="检查更新"
                        FontSize="12"
                        Padding="12,6"
                        MinWidth="80"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="#0067c0"
                        BorderThickness="1"
                        CornerRadius="16"
                        Foreground="#0067c0"
                        Cursor="Hand"
                        Click="CheckUpdateButton_Click" />
            </StackPanel>

            <TextBlock Name="UpdateStatusText"
                       Text=""
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="420"
                       Opacity="0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>