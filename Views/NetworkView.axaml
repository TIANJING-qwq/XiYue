<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.NetworkView"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Margin="32" Spacing="20">

            <TextBlock Text="网络" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="网络状态与连接管理"
                       FontSize="14" Opacity="0.6" />

            <!-- 连接状态 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="连接状态" FontSize="16" FontWeight="SemiBold" />

                    <TextBlock Text="{Binding StatusText}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{Binding StatusBrush}" />

                    <TextBlock Text="{Binding LoadingText}"
                               FontSize="13"
                               Foreground="Gray"
                               FontStyle="Italic" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                          Margin="0,8,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="本地 IP：" FontSize="13" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LocalIp}" FontSize="13" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="公网 IP：" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PublicIp}" FontSize="13" Margin="0,4,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="上次检测：" FontSize="13" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastCheck}" FontSize="13" Margin="0,4,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 连接统计 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="连接统计" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Attempts, StringFormat='连接尝试: {0}'}" FontSize="13" />
                    <TextBlock Text="{Binding LastConnectionInfo}" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- 控制面板 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="控制面板" FontSize="16" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="启用自动连接" VerticalAlignment="Center" Width="160" />
                        <ToggleSwitch IsChecked="{Binding AutoConnectEnabled}" OnContent="" OffContent="" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="自动验证网络" VerticalAlignment="Center" Width="160" />
                        <ToggleSwitch IsChecked="{Binding AutoVerifyEnabled}" OnContent="" OffContent="" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Name="ConnectButton" Content="立即连接" Click="ConnectButton_Click" />
                        <Button Name="RefreshButton" Content="刷新状态" Click="RefreshButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>