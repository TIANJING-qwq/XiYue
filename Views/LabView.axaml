<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.LabView">
    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Margin="32,24,32,12" Spacing="4">
            <TextBlock Text="实验室" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="实验性功能与工具"
                       FontSize="14" Opacity="0.6" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="24,0,24,24">

            <!-- ========== 通知测试 ========== -->
            <TabItem Header="通知测试">
                <ScrollViewer>
                    <StackPanel Margin="16,20" Spacing="20">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="通知测试" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="通知会从右侧滑入，5 秒后自动消失。连续点击按钮，通知会向下堆叠；超出窗口高度时自动压缩，点击通知区域可展开/折叠。"
                                           FontSize="13" Opacity="0.7"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="显示 1 条" Click="TestNotification_Click" />
                                    <Button Content="显示 5 条" Click="BurstNotification_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 实时日志 ========== -->
            <TabItem Header="实时日志">
                <Grid RowDefinitions="Auto,*,Auto" Margin="16,20">

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="0,0,0,10">
                        <Button Name="ClearLogButton"
                                Content="清空"
                                Click="ClearLogButton_Click" />
                        <Button Name="SaveLogButton"
                                Content="保存"
                                Click="SaveLogButton_Click" />
                        <ToggleSwitch Name="AutoScrollSwitch"
                                      OnContent="自动滚动"
                                      OffContent="自动滚动"
                                      IsChecked="True"
                                      VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#1E1E1E"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer Name="LogScrollViewer">
                            <ItemsControl Name="LogList" Margin="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#D4D4D4"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   FontSize="12"
                                                   TextWrapping="NoWrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Name="LogStatusText"
                               FontSize="11"
                               Opacity="0.6"
                               Margin="0,8,0,0"
                               Text="就绪" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>