<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SBtools.Views.AboutView">

    <StackPanel Margin="32"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="10">

        <!-- 英文标题（动画：XY → XiYue） -->
        <TextBlock Name="TitleText"
                   Text="XY"
                   FontSize="42"
                   FontWeight="Bold"
                   Foreground="#0067c0"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <!-- 中文名 -->
        <TextBlock Name="ChineseName"
                   Text="汐月"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#0067c0"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <!-- 副标题 -->
        <TextBlock Name="SubtitleText"
                   Text="Xiyue"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <Border Name="Divider"
                Height="1" Width="180"
                Background="#e5e5e5"
                Margin="0,10"
                Opacity="0" />

        <TextBlock Name="LineAuthor"
                   Text="SchoolBusytools 项目组制作"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <TextBlock Name="LineTeam"
                   Text="tianjing &amp; deepseek"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <TextBlock Name="LineBuild"
                   Text="基于 C# / .NET 8 + Avalonia UI 构建"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,0"
                   Opacity="0" />

        <TextBlock Name="LineVersion"
                   Text="版本 1.2.0"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <TextBlock Name="LineDesc"
                   Text="校园网自动认证 · 轻量校园工具集"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Opacity="0" />

        <!-- GitHub 链接 -->
        <Button Name="GitHubButton"
                Content="github.com/TIANJING-qwq/SBtools"
                FontSize="12"
                Padding="12,6"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderBrush="#0067c0"
                BorderThickness="1"
                CornerRadius="16"
                Foreground="#0067c0"
                Cursor="Hand"
                Opacity="0"
                Click="GitHubButton_Click" />
    </StackPanel>
</UserControl>