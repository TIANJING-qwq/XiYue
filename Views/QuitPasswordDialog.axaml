<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ea="using:Avalonia.Animation.Easings"
        x:Class="SBtools.Views.QuitPasswordDialog"
        Title="退出验证"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border x:Name="RootCard"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="12"
            Padding="0"
            Margin="1">

        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.22">
                    <DoubleTransition.Easing>
                        <ea:CubicEaseOut/>
                    </DoubleTransition.Easing>
                </DoubleTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28">
                    <TransformOperationsTransition.Easing>
                        <ea:QuinticEaseOut/>
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Border.Transitions>

        <Border Background="#F0101010"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28">

            <Border.Styles>
                <Style Selector="Button.cancel">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="20,8"/>
                    <Setter Property="MinWidth" Value="88"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="Button.cancel /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="Button.cancel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </Style>

                <Style Selector="Button.confirm">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="20,8"/>
                    <Setter Property="MinWidth" Value="88"/>
                    <Setter Property="CornerRadius" Value="6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <Style Selector="Button.confirm /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FFE81123"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
                <Style Selector="Button.confirm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FFC50F1F"/>
                </Style>
                <Style Selector="Button.confirm:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#FFA8001A"/>
                </Style>
            </Border.Styles>

            <StackPanel Spacing="16">

                <TextBlock Text="退出汐月"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="请输入退出安全码："
                           FontSize="13"
                           Foreground="#CCFFFFFF"/>

                <TextBox x:Name="PasswordBox"
                         PasswordChar="●"
                         Watermark="输入安全码"
                         FontSize="14"
                         Padding="10,8"
                         KeyDown="PasswordBox_KeyDown"/>

                <TextBlock x:Name="ErrorText"
                           Text=""
                           FontSize="12"
                           Foreground="#FFE81123"
                           IsVisible="False"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10"
                            Margin="0,4,0,0">

                    <Button x:Name="CancelButton"
                            Classes="cancel"
                            Content="取消"
                            Click="CancelButton_Click"/>

                    <Button x:Name="ConfirmButton"
                            Classes="confirm"
                            Content="退出"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>